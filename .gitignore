# ===== local machine config =====
# Written by scripts/setup_local.py; the path differs on every machine.
.peergrading.json
.env
*.env

# ===== python =====
__pycache__/
*.py[cod]
*.pyd

.venv/
venv/

# ===== course data =====
# Inputs and outputs live in the synced SharePoint folder, never in git.
# A local copy here (for testing, say) must not be committed: it holds student
# names, email addresses and grades.
PeerGrading/

# ===== test output =====
# Written by the test suite so the generated CSVs and .eml files can be
# inspected by hand; regenerated on every run.
artifacts/
.pytest_cache/

# ===== logs =====
logs/

# ===== OS =====
.DS_Store
Thumbs.db
